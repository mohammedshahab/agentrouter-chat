# AgentRouter API key. Required.
# Get one from https://agentrouter.org/console/token
AGENTROUTER_API_KEY=sk-your-key-here

# Optional: override the OpenAI-compatible base URL.
#
# NOTE: https://agentrouter.org is behind an Aliyun WAF that blocks server-side
# requests. By default the app uses a Cloudflare Worker proxy that forwards
# requests to agentrouter.org and bypasses the WAF:
#
#   https://agentrouter-proxy.fbfgbffbfdbd.workers.dev/v1   (default)
#
# You can point at any OpenAI-compatible API (OpenRouter, OpenAI, Groq, etc.)
# by overriding this variable and AGENTROUTER_API_KEY.
# AGENTROUTER_BASE_URL=https://agentrouter-proxy.fbfgbffbfdbd.workers.dev/v1

# Optional: change the default model.
# Examples: gpt-5, glm-4.6, glm-4.5, deepseek-v3.1
# AGENTROUTER_MODEL=gpt-5

# Optional: customize the system prompt.
# AGENTROUTER_SYSTEM_PROMPT="You are a helpful assistant."
