# AgentRouter API key. Required.
# Get one from https://agentrouter.org/console/token
AGENTROUTER_API_KEY=sk-your-key-here

# Optional: override the OpenAI-compatible base URL.
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# Optional: change the default model.
# Examples: gpt-5, glm-4.6, glm-4.5, deepseek-v3.1
# AGENTROUTER_MODEL=gpt-5

# Optional: customize the system prompt.
# AGENTROUTER_SYSTEM_PROMPT="You are a helpful assistant."
